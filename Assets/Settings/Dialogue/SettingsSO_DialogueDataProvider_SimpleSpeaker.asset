MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e1ffb9aeecd940eeae45d2a07d76492a, type: 3}
  m_Name: SettingsSO_DialogueDataProvider_SimpleSpeaker
  m_EditorClassIdentifier: 
  _dialogueDataSettingsColl:
  - _dialogue: 20001
    _dialogueData:
    - _speaker: 100
      _speakerText:
      - Request connection.
    - _speaker: 300
      _speakerText:
      - "Request granted.\t Connecting."
      - Connected.
    - _speaker: 100
      _speakerText:
      - I have reached the location.
      - Waiting for commands.
    - _speaker: 200
      _speakerText:
      - Access authorized. You can proceed with Pursuit 0384.
    - _speaker: 100
      _speakerText:
      - ...
    - _speaker: 200
      _speakerText:
      - Hey, Yu.
    - _speaker: 100
      _speakerText:
      - Yes, Overseer.
    - _speaker: 200
      _speakerText:
      - You can try to be more careful this time.
    - _speaker: 100
      _speakerText:
      - Understood. Out.
  - _dialogue: 10001
    _dialogueData:
    - _speaker: 2
      _speakerText:
      - '<alpha=#88>Press <alpha=#FF><b>A, D</b><alpha=#88> to move <alpha=#FF><b>left</b><alpha=#88>
        and <alpha=#FF><b>right</b>.

        <alpha=#88>Press<alpha=#FF> <b>W, S</b>
        <alpha=#88>to move <alpha=#FF><b>front</b> <alpha=#88>and <alpha=#FF><b>back</b>.'
  - _dialogue: 10002
    _dialogueData:
    - _speaker: 2
      _speakerText:
      - '<alpha=#88>Press <alpha=#FF><b>space</b> <alpha=#88>to <alpha=#FF><b>jump</b>.

        <alpha=#88>Press
        space again to <alpha=#FF><b>double jump</b><alpha=#88> in mid air.'
  - _dialogue: 10003
    _dialogueData:
    - _speaker: 2
      _speakerText:
      - <alpha=#88>Press <alpha=#FF><b>Left CTRL</b> <alpha=#88>to <alpha=#FF><b>dash</b>.
  - _dialogue: 10011
    _dialogueData:
    - _speaker: 2
      _speakerText:
      - <alpha=#88>Click <alpha=#FF><b> left mouse button</b> <alpha=#88>to perform
        <alpha=#FF><b>melee attack</b>.
  - _dialogue: 10021
    _dialogueData:
    - _speaker: 2
      _speakerText:
      - <alpha=#88>Click <alpha=#FF><b> right mouse button</b> <alpha=#88>to perform<alpha=#FF>
        <b>range attack</b>.
  - _dialogue: 30001
    _dialogueData:
    - _speaker: 400
      _speakerText:
      - Hey, Z. Can you.. Can you try connect to Zero?
  - _dialogue: 30002
    _dialogueData:
    - _speaker: 500
      _speakerText:
      - It's still out of reach Yu.
  - _dialogue: 30003
    _dialogueData:
    - _speaker: 400
      _speakerText:
      - Oh, okay.
  - _dialogue: 20002
    _dialogueData:
    - _speaker: 300
      _speakerText:
      - We must be getting close Yu. Be prepared.
  - _dialogue: 20101
    _dialogueData:
    - _speaker: 300
      _speakerText:
      - Receiving enemy signal. Some must be guarding the building. Prepare for combat.
  - _dialogue: 20102
    _dialogueData:
    - _speaker: 300
      _speakerText:
      - Receving more enemy signal. Target predicted to be in the second floor.
  - _dialogue: 20102
    _dialogueData:
    - _speaker: 300
      _speakerText:
      - Receiving more enemy signal. Proceed to the second floor.
