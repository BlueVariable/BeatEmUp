  _dialogueDataSettingsColl:
  - _dialogue: 20001
    _dialogueData:
    - _speaker: 100
      _speakerText:
      - Request connection.
    - _speaker: 300
      _speakerText:
      - "Request granted.\t Connecting."
      - Connected.
    - _speaker: 100
      _speakerText:
      - I have reached the location.
      - Waiting for commands.
    - _speaker: 200
      _speakerText:
      - Access authorized. You can proceed with Pursuit 0384.
    - _speaker: 100
      _speakerText:
      - ...
    - _speaker: 200
      _speakerText:
      - Hey, Yu.
    - _speaker: 100
      _speakerText:
      - Yes, Overseer.
    - _speaker: 200
      _speakerText:
      - You can try to be more careful this time.
    - _speaker: 100
      _speakerText:
      - Understood. Out.
  - _dialogue: 10001
    _dialogueData:
    - _speaker: 2
      _speakerText:
      - 'Press <b>A, D</b> to move left and right.

        Press <b>W, S</b> to
        move front and back.'
