MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e1ffb9aeecd940eeae45d2a07d76492a, type: 3}
  m_Name: SettingsSO_DialogueDataProvider_SimpleSpeaker
  m_EditorClassIdentifier: 
  _dialogueDataSettingsColl:
  - _dialogue: 20001
    _dialogueData:
    - _speaker: 100
      _speakerText:
      - Request connection.
    - _speaker: 300
      _speakerText:
      - "Request granted.\t Connecting."
      - Connected.
    - _speaker: 100
      _speakerText:
      - I have reached the location.
      - Waiting for commands.
    - _speaker: 200
      _speakerText:
      - Access authorized. You can proceed with Pursuit 0384.
    - _speaker: 100
      _speakerText:
      - ...
    - _speaker: 200
      _speakerText:
      - Hey, Yu.
    - _speaker: 100
      _speakerText:
      - Yes, Overseer.
    - _speaker: 200
      _speakerText:
      - You can try to be more careful this time.
    - _speaker: 100
      _speakerText:
      - Understood. Out.
  - _dialogue: 10001
    _dialogueData:
    - _speaker: 2
      _speakerText:
      - 'Press <b>A, D</b> to move <b>left</b> and <b>right</b>.

        Press <b>W,
        S</b> to move <b>front</b> and <b>back</b>.'
  - _dialogue: 10002
    _dialogueData:
    - _speaker: 2
      _speakerText:
      - 'Press <b>space</b> to <b>jump</b>.

        Press space again to <b>double
        jump</b> in mid air.'
  - _dialogue: 10003
    _dialogueData:
    - _speaker: 2
      _speakerText:
      - Press <b>shift</b> to <b>dash</b>.
  - _dialogue: 30001
    _dialogueData:
    - _speaker: 400
      _speakerText:
      - Hey, Z. Can you.. Can you try connect to Zero?
  - _dialogue: 30002
    _dialogueData:
    - _speaker: 500
      _speakerText:
      - It's still out of reach Yu.
  - _dialogue: 30003
    _dialogueData:
    - _speaker: 400
      _speakerText:
      - Oh, okay.
  - _dialogue: 20002
    _dialogueData:
    - _speaker: 300
      _speakerText:
      - We must be getting close Yu. Be prepared.
